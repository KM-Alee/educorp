/* ═══════════════════════════════════════════════════════════════════
   Utility classes
   ═══════════════════════════════════════════════════════════════════ */

/* ─── Text ─── */
.text-display   { font-family: var(--font-display); font-size: 32px; font-weight: 500; line-height: 1.15; }
.text-h1        { font-family: var(--font-display); font-size: 24px; font-weight: 500; line-height: 1.2; }
.text-h2        { font-family: var(--font-display); font-size: 20px; font-weight: 500; line-height: 1.25; }
.text-h3        { font-family: var(--font-body);    font-size: 16px; font-weight: 600; line-height: 1.35; }
.text-body-lg   { font-size: 16px; font-weight: 400; line-height: 1.56; }
.text-body      { font-size: 14px; font-weight: 400; line-height: 1.56; }
.text-sm        { font-size: 13px; font-weight: 400; line-height: 1.5; }
.text-caption   { font-size: 12px; font-weight: 500; line-height: 1.4; }
.text-mono      { font-family: var(--font-mono); font-size: 13px; }

.text-muted     { color: var(--black-muted); }
.text-faint     { color: var(--black-faint); }
.text-success   { color: var(--success); }
.text-danger    { color: var(--danger); }
.text-warning   { color: var(--warning); }

/* ─── Layout ─── */
.flex        { display: flex; }
.flex-col    { display: flex; flex-direction: column; }
.flex-wrap   { flex-wrap: wrap; }
.items-center { align-items: center; }
.items-start  { align-items: flex-start; }
.justify-between { justify-content: space-between; }
.justify-center  { justify-content: center; }
.flex-1      { flex: 1; }
.shrink-0    { flex-shrink: 0; }

.gap-1  { gap: var(--space-1); }
.gap-2  { gap: var(--space-2); }
.gap-3  { gap: var(--space-3); }
.gap-4  { gap: var(--space-4); }
.gap-5  { gap: var(--space-5); }
.gap-6  { gap: var(--space-6); }
.gap-8  { gap: var(--space-8); }

/* ─── Spacing ─── */
.mt-1 { margin-top: var(--space-1); }
.mt-2 { margin-top: var(--space-2); }
.mt-3 { margin-top: var(--space-3); }
.mt-4 { margin-top: var(--space-4); }
.mt-6 { margin-top: var(--space-6); }
.mt-8 { margin-top: var(--space-8); }
.mb-2 { margin-bottom: var(--space-2); }
.mb-4 { margin-bottom: var(--space-4); }
.mb-6 { margin-bottom: var(--space-6); }

/* ─── Sizing ─── */
.w-full   { width: 100%; }
.max-w-narrow { max-width: var(--container-narrow); }
.max-w-container { max-width: var(--container-max); }

/* ─── Visibility ─── */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* ─── Truncate ─── */
.truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
