/* ═══════════════════════════════════════════════════════════════════
   Component Styles — cream/black/white system
   ═══════════════════════════════════════════════════════════════════ */

/* ─── Buttons ─── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  height: 36px;
  padding: 0 var(--space-4);
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 500;
  line-height: 1;
  border: 1px solid transparent;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--black);
  cursor: pointer;
  white-space: nowrap;
  transition: background 150ms ease, border-color 150ms ease, color 150ms ease;
}

.btn:focus-visible {
  outline: none;
  box-shadow: var(--shadow-focus);
}

.btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.btn--primary {
  background: var(--black);
  color: var(--white);
  border-color: var(--black);
}
.btn--primary:hover:not(:disabled) {
  background: var(--accent-hover);
}

.btn--secondary {
  background: transparent;
  color: var(--black);
  border-color: var(--border-strong);
}
.btn--secondary:hover:not(:disabled) {
  background: var(--cream-dark);
  border-color: var(--black-faint);
}

.btn--ghost {
  background: transparent;
  color: var(--black-muted);
  border-color: transparent;
}
.btn--ghost:hover:not(:disabled) {
  color: var(--black);
  background: var(--cream-dark);
}

.btn--danger {
  background: var(--danger);
  color: var(--white);
  border-color: var(--danger);
}
.btn--danger:hover:not(:disabled) {
  background: #A8222A;
}

.btn--sm {
  height: 32px;
  padding: 0 var(--space-3);
  font-size: 13px;
}

.btn--icon {
  width: 36px;
  padding: 0;
  justify-content: center;
}

.btn--icon.btn--sm {
  width: 32px;
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  align-items: center;
}

/* ─── Cards ─── */
.card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--space-5);
  box-shadow: var(--shadow-sm);
}

.card--clickable {
  cursor: pointer;
  transition: border-color 150ms ease;
}
.card--clickable:hover {
  border-color: var(--border-strong);
}

.card__header {
  margin-bottom: var(--space-4);
}

.card__title {
  margin: 0;
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 500;
}

.card__description {
  margin: var(--space-1) 0 0;
  font-size: 13px;
  color: var(--black-muted);
}

/* ─── Badges / Status Chips ─── */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 2px var(--space-2);
  font-size: 12px;
  font-weight: 500;
  line-height: 1.4;
  border-radius: var(--radius-xs);
  background: #F0EFEC;
  color: var(--black-muted);
}

.badge--success  { background: var(--success-bg); color: var(--success); }
.badge--danger   { background: var(--danger-bg);  color: var(--danger); }
.badge--warning  { background: var(--warning-bg); color: var(--warning); }
.badge--info     { background: var(--info-bg);    color: var(--info); }

.badge-group {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
}

/* ─── Messages / Alerts ─── */
.message {
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-sm);
  font-size: 13px;
  line-height: 1.5;
  border: 1px solid;
}

.message--error   { background: var(--danger-bg);  color: var(--danger);  border-color: #F5C6CB; }
.message--success { background: var(--success-bg); color: var(--success); border-color: #B7E4C7; }
.message--warning { background: var(--warning-bg); color: var(--warning); border-color: #FDE68A; }
.message--info    { background: var(--info-bg);    color: var(--info);    border-color: #BFDBFE; }

/* ─── Forms ─── */
.form-stack {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.form-row {
  display: grid;
  gap: var(--space-4);
  grid-template-columns: repeat(2, 1fr);
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.form-field__label {
  font-size: 13px;
  font-weight: 500;
  color: var(--black-muted);
}

.form-field input,
.form-field textarea,
.form-field select {
  width: 100%;
  height: 36px;
  padding: 0 var(--space-3);
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 14px;
  color: var(--black);
  transition: border-color 150ms ease, box-shadow 150ms ease;
}

.form-field textarea {
  height: auto;
  min-height: 80px;
  padding: var(--space-2) var(--space-3);
  resize: vertical;
}

.form-field input::placeholder,
.form-field textarea::placeholder {
  color: var(--black-faint);
}

.form-field input:focus,
.form-field textarea:focus,
.form-field select:focus {
  outline: none;
  border-color: var(--black);
  box-shadow: 0 0 0 1px var(--black);
}

.form-field select {
  appearance: none;
  padding-right: 2.5rem;
  background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1.5L6 6.5L11 1.5' stroke='%236B6B6B' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-position: right 12px center;
}

.form-field__error {
  font-size: 13px;
  color: var(--danger);
}

.form-field--inline {
  flex-direction: row;
  align-items: center;
  gap: var(--space-2);
}

.form-field--inline input[type="checkbox"] {
  width: 16px;
  height: 16px;
  accent-color: var(--black);
}

/* ─── Tables ─── */
.table-wrap {
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--white);
}

.table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

.table th {
  padding: var(--space-3) var(--space-4);
  text-align: left;
  font-size: 12px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--black-faint);
  border-bottom: 1px solid var(--border);
  background: var(--cream-light);
}

.table td {
  padding: var(--space-3) var(--space-4);
  border-bottom: 1px solid var(--border-on-white);
  vertical-align: middle;
  color: var(--black);
}

.table tbody tr:last-child td {
  border-bottom: none;
}

.table tbody tr:hover {
  background: var(--cream-light);
}

.table__secondary {
  color: var(--black-muted);
  font-size: 12px;
}

/* ─── Stat Cards ─── */
.stat-row {
  display: grid;
  gap: var(--space-3);
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
}

.stat-item {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--space-4);
}

.stat-item__label {
  font-size: 12px;
  font-weight: 500;
  color: var(--black-faint);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.stat-item__value {
  margin-top: var(--space-1);
  font-family: var(--font-display);
  font-size: 24px;
  font-weight: 500;
  color: var(--black);
}

/* ─── Empty State ─── */
.empty {
  padding: var(--space-10) var(--space-6);
  text-align: center;
  color: var(--black-faint);
  border: 1px dashed var(--border-strong);
  border-radius: var(--radius-md);
  background: var(--cream-light);
}

.empty__icon {
  font-size: 32px;
  margin-bottom: var(--space-3);
  opacity: 0.5;
}

.empty__title {
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 500;
  color: var(--black-muted);
  margin-bottom: var(--space-2);
}

.empty__description {
  font-size: 14px;
  color: var(--black-faint);
  max-width: 360px;
  margin: 0 auto;
}

/* ─── Skeleton Loading ─── */
@keyframes shimmer {
  0%   { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.skeleton {
  background: linear-gradient(90deg, var(--cream-dark) 25%, var(--cream-light) 50%, var(--cream-dark) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease infinite;
  border-radius: var(--radius-sm);
}

.skeleton--text {
  height: 14px;
  width: 60%;
}

.skeleton--title {
  height: 24px;
  width: 40%;
}

.skeleton--card {
  height: 120px;
  width: 100%;
}

.skeleton--avatar {
  height: 40px;
  width: 40px;
  border-radius: 50%;
}

/* ─── Progress Bar ─── */
.progress-bar {
  height: 6px;
  background: var(--cream-dark);
  border-radius: var(--radius-pill);
  overflow: hidden;
}

.progress-bar__fill {
  height: 100%;
  background: var(--black);
  border-radius: var(--radius-pill);
  transition: width 300ms ease;
}

.progress-bar--success .progress-bar__fill {
  background: var(--success);
}

/* ─── Filter Bar ─── */
.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  align-items: flex-end;
}

.filter-bar .form-field {
  min-width: 10rem;
}

/* ─── Page Layout ─── */
.page-header {
  margin-bottom: var(--space-6);
}

.page-header__title {
  margin: 0;
  font-family: var(--font-display);
  font-size: 32px;
  font-weight: 500;
  line-height: 1.15;
  color: var(--black);
}

.page-header__description {
  margin: var(--space-1) 0 0;
  font-size: 15px;
  color: var(--black-muted);
}

.page-header__breadcrumb {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
  font-size: 13px;
  color: var(--black-faint);
}

.page-header__breadcrumb a {
  color: var(--black-muted);
  text-decoration: none;
}
.page-header__breadcrumb a:hover {
  color: var(--black);
}

.page-stack {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.page-columns {
  display: grid;
  gap: var(--space-6);
  grid-template-columns: 1fr 320px;
}

/* ─── Pagination ─── */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: var(--space-4) 0;
}

.pagination__info {
  font-size: 13px;
  color: var(--black-muted);
  margin-right: auto;
}

/* ─── Tooltip ─── */
.tooltip {
  position: relative;
}

.tooltip__content {
  position: absolute;
  bottom: calc(100% + 6px);
  left: 50%;
  transform: translateX(-50%);
  padding: var(--space-1) var(--space-2);
  background: var(--black);
  color: var(--white);
  font-size: 12px;
  border-radius: var(--radius-xs);
  white-space: nowrap;
  pointer-events: none;
  opacity: 0;
  transition: opacity 150ms ease;
}

.tooltip:hover .tooltip__content {
  opacity: 1;
}

/* ─── Modal / Confirm Dialog ─── */
.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.4);
  padding: var(--space-4);
}

.modal {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  width: 100%;
  max-width: 480px;
  box-shadow: var(--shadow-lg);
}

.modal__title {
  margin: 0 0 var(--space-2);
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 500;
}

.modal__body {
  font-size: 14px;
  color: var(--black-muted);
  margin-bottom: var(--space-6);
  line-height: 1.56;
}

.modal__actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-2);
}

/* ─── Sidebar ─── */
.sidebar {
  width: var(--sidebar-width);
  background: var(--white);
  border-right: 1px solid var(--border);
  padding: var(--space-4) 0;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  flex-shrink: 0;
}

.sidebar__brand {
  padding: 0 var(--space-5);
  margin-bottom: var(--space-6);
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 500;
  color: var(--black);
}

.sidebar__brand a {
  color: inherit;
  text-decoration: none;
}

.sidebar__section {
  margin-bottom: var(--space-4);
}

.sidebar__label {
  padding: var(--space-1) var(--space-5);
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--black-faint);
}

.sidebar__link {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-2) var(--space-5);
  font-size: 14px;
  font-weight: 400;
  color: var(--black-muted);
  text-decoration: none;
  border-radius: 0;
  transition: background 100ms ease, color 100ms ease;
}

.sidebar__link:hover {
  color: var(--black);
  background: var(--cream-light);
}

.sidebar__link.active {
  color: var(--black);
  font-weight: 500;
  background: var(--cream);
}

.sidebar__divider {
  height: 1px;
  background: var(--border);
  margin: var(--space-3) var(--space-5);
}

/* ─── Top Bar ─── */
.topbar {
  height: var(--header-height);
  background: var(--white);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 var(--space-6);
  gap: var(--space-4);
  flex-shrink: 0;
}

.topbar__spacer {
  flex: 1;
}

.topbar__actions {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.topbar__user {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: 13px;
  color: var(--black-muted);
}

/* ─── Breadcrumbs ─── */
.breadcrumbs {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: 13px;
  color: var(--black-faint);
}

.breadcrumbs__separator {
  color: var(--border-strong);
}

.breadcrumbs a {
  color: var(--black-muted);
  text-decoration: none;
}

.breadcrumbs a:hover {
  color: var(--black);
}

/* ─── Tab Navigation ─── */
.tab-nav {
  display: flex;
  gap: 0;
  border-bottom: 1px solid var(--border);
  margin-bottom: var(--space-6);
}

.tab-nav__item {
  padding: var(--space-3) var(--space-4);
  font-size: 14px;
  font-weight: 450;
  color: var(--black-muted);
  text-decoration: none;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
  transition: color 150ms ease, border-color 150ms ease;
}

.tab-nav__item:hover {
  color: var(--black);
}

.tab-nav__item.active {
  color: var(--black);
  font-weight: 500;
  border-bottom-color: var(--black);
}

/* ─── Notification Bell ─── */
.notification-bell {
  position: relative;
  display: inline-flex;
}

.notification-bell__count {
  position: absolute;
  top: -4px;
  right: -4px;
  min-width: 16px;
  height: 16px;
  padding: 0 4px;
  background: var(--danger);
  color: var(--white);
  font-size: 10px;
  font-weight: 600;
  line-height: 16px;
  text-align: center;
  border-radius: var(--radius-pill);
}

/* ─── Avatar ─── */
.avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--cream-dark);
  color: var(--black-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 600;
  flex-shrink: 0;
  overflow: hidden;
}

.avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar--lg {
  width: 48px;
  height: 48px;
  font-size: 18px;
}

/* ─── Timeline ─── */
.timeline {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding-left: var(--space-5);
  border-left: 2px solid var(--border);
}

.timeline__item {
  position: relative;
  padding: var(--space-3) 0 var(--space-3) var(--space-5);
}

.timeline__item::before {
  content: '';
  position: absolute;
  left: calc(-1 * var(--space-5) - 5px);
  top: var(--space-4);
  width: 8px;
  height: 8px;
  background: var(--border-strong);
  border-radius: 50%;
}

.timeline__item--active::before {
  background: var(--black);
}

.timeline__item--success::before {
  background: var(--success);
}

.timeline__item--error::before {
  background: var(--danger);
}

.timeline__title {
  font-size: 14px;
  font-weight: 500;
  color: var(--black);
}

.timeline__meta {
  font-size: 12px;
  color: var(--black-faint);
  margin-top: 2px;
}

/* ─── Course Item (list style) ─── */
.course-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.course-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  padding: var(--space-4) var(--space-5);
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  transition: border-color 150ms ease;
}

.course-item:hover {
  border-color: var(--border-strong);
}

.course-item__info {
  min-width: 0;
  flex: 1;
}

.course-item__title {
  font-weight: 500;
  font-size: 15px;
  color: var(--black);
}

.course-item__meta {
  font-size: 13px;
  color: var(--black-muted);
  margin-top: 2px;
}

.course-item__actions {
  display: flex;
  gap: var(--space-2);
  align-items: center;
  flex-shrink: 0;
}

/* ─── Module Panel ─── */
.module-panel {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--space-4);
}

.module-panel + .module-panel {
  margin-top: var(--space-3);
}

.module-panel__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
}

.module-panel__title {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: 15px;
  color: var(--black);
}

/* ─── Auth Layout ─── */
.auth-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-8) var(--space-4);
  background: var(--cream);
}

.auth-card {
  width: 100%;
  max-width: 440px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-8);
  box-shadow: var(--shadow-md);
}

.auth-card__header {
  margin-bottom: var(--space-6);
}

.auth-card__logo {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: 14px;
  letter-spacing: 0.02em;
  color: var(--black-faint);
  margin-bottom: var(--space-3);
}

.auth-card__title {
  margin: 0;
  font-family: var(--font-display);
  font-size: 24px;
  font-weight: 500;
  line-height: 1.2;
  color: var(--black);
}

.auth-card__subtitle {
  margin: var(--space-2) 0 0;
  font-size: 14px;
  color: var(--black-muted);
}

.auth-footer {
  margin-top: var(--space-4);
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-4);
  font-size: 13px;
}

.auth-footer a {
  color: var(--black-muted);
}
.auth-footer a:hover {
  color: var(--black);
}

.auth-hint {
  margin-top: var(--space-3);
  font-size: 12px;
  color: var(--black-faint);
  font-family: var(--font-mono);
}

/* ─── Public Layout ─── */
.public-layout {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--cream);
}

.public-nav {
  position: sticky;
  top: 0;
  z-index: 100;
  height: var(--header-height);
  display: flex;
  align-items: center;
  gap: var(--space-6);
  padding: 0 var(--space-6);
  background: var(--cream);
  border-bottom: 1px solid var(--border);
  transition: box-shadow 200ms ease;
}

.public-nav--scrolled {
  box-shadow: var(--shadow-sm);
}

.public-nav__brand {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: 18px;
  color: var(--black);
  flex-shrink: 0;
}

.public-nav__brand a {
  color: inherit;
  text-decoration: none;
}

.public-nav__spacer {
  flex: 1;
}

.public-nav__links {
  display: flex;
  align-items: center;
  gap: var(--space-1);
}

.public-nav__link {
  display: inline-flex;
  align-items: center;
  padding: var(--space-2) var(--space-3);
  font-size: 14px;
  font-weight: 450;
  color: var(--black-muted);
  text-decoration: none;
  border-radius: var(--radius-sm);
  transition: color 150ms ease, background 150ms ease;
}

.public-nav__link:hover {
  color: var(--black);
  background: var(--cream-dark);
}

/* ─── App Shell ─── */
.app-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--cream);
}

.app-body {
  display: flex;
  flex: 1;
}

.app-main {
  flex: 1;
  padding: var(--space-8) var(--space-8);
  max-width: var(--container-max);
  min-width: 0;
}

/* ─── Hero (public landing) ─── */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  min-height: 70vh;
  padding: var(--space-16) var(--space-6);
  background: var(--cream);
}

.hero__display {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: clamp(36px, 6vw, 56px);
  line-height: 1.08;
  color: var(--black);
  margin: 0 0 var(--space-6);
  max-width: 720px;
}

.hero__subtitle {
  font-size: clamp(15px, 1.5vw, 18px);
  font-weight: 400;
  color: var(--black-muted);
  line-height: 1.56;
  max-width: 540px;
  margin: 0 0 var(--space-8);
}

.hero__actions {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
  justify-content: center;
}

.hero__stats {
  display: flex;
  gap: var(--space-16);
  margin-top: var(--space-16);
}

.hero__stat {
  text-align: center;
}

.hero__stat-value {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: 36px;
  line-height: 1;
  color: var(--black);
}

.hero__stat-label {
  font-size: 13px;
  font-weight: 500;
  color: var(--black-faint);
  margin-top: var(--space-2);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

/* ─── Section ─── */
.section {
  padding: var(--space-16) var(--space-6);
  max-width: var(--container-max);
  margin: 0 auto;
}

.section__heading {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: clamp(24px, 3vw, 36px);
  line-height: 1.15;
  margin: 0 0 var(--space-3);
  color: var(--black);
}

.section__lead {
  font-size: 16px;
  color: var(--black-muted);
  max-width: 540px;
  margin: 0 0 var(--space-10);
  line-height: 1.56;
}

/* ─── Feature Grid ─── */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: var(--space-5);
}

.feature-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--space-6);
  transition: border-color 200ms ease;
}

.feature-card:hover {
  border-color: var(--border-strong);
}

.feature-card__icon {
  font-size: 24px;
  margin-bottom: var(--space-3);
  opacity: 0.6;
}

.feature-card__title {
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 500;
  margin: 0 0 var(--space-2);
  color: var(--black);
}

.feature-card__body {
  font-size: 14px;
  color: var(--black-muted);
  line-height: 1.56;
  margin: 0;
}

/* ─── Meta Items ─── */
.meta-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.meta-item {
  padding: var(--space-3);
  background: var(--cream-light);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
}

.meta-item__label {
  font-size: 11px;
  font-weight: 600;
  color: var(--black-faint);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.meta-item__value {
  font-size: 14px;
  margin-top: 2px;
  color: var(--black);
}

/* ─── AI Panels ─── */
.ai-panel {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.ai-panel__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-4);
}

.ai-panel__title {
  margin: 0;
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 500;
  color: var(--black);
}

.ai-panel__subtitle {
  margin: var(--space-1) 0 0;
  font-size: 13px;
  color: var(--black-muted);
}

.ai-panel__controls {
  display: grid;
  gap: var(--space-4);
}

.ai-panel__messages {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.ai-message {
  padding: var(--space-4);
  border-radius: var(--radius-md);
  background: var(--cream-light);
  border: 1px solid var(--border);
}

.ai-message--user {
  background: var(--white);
  border-color: var(--border-strong);
}

.ai-message__role {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--black-faint);
  font-weight: 600;
  margin-bottom: var(--space-2);
}

.ai-message__content {
  white-space: pre-wrap;
  font-size: 14px;
  line-height: 1.56;
  color: var(--black);
}

.ai-message__citations {
  margin-top: var(--space-3);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.ai-citation {
  padding: var(--space-3);
  border-radius: var(--radius-sm);
  background: var(--cream-light);
  border: 1px dashed var(--border-strong);
}

.ai-citation__title {
  font-size: 11px;
  color: var(--black-faint);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-weight: 600;
  margin-bottom: var(--space-1);
}

.ai-citation__snippet {
  font-size: 13px;
  color: var(--black-muted);
  line-height: 1.5;
}

.ai-panel__result {
  background: var(--cream-light);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--space-4);
}

.ai-panel__status {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
  font-size: 13px;
  color: var(--black-muted);
}

.ai-panel__output {
  margin: 0;
  white-space: pre-wrap;
  font-family: var(--font-mono);
  font-size: 13px;
  line-height: 1.6;
  background: var(--white);
  border-radius: var(--radius-sm);
  padding: var(--space-4);
  color: var(--black-muted);
  border: 1px solid var(--border);
}

/* ─── Validation ─── */
.validation-result {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.validation-issue {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: var(--space-3);
  background: var(--cream-light);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 13px;
}

.validation-issue__field {
  font-weight: 500;
  color: var(--black);
}

.validation-issue__message {
  color: var(--black-muted);
}

/* ─── JSON Editor ─── */
.json-editor {
  min-height: 200px;
  font-family: var(--font-mono);
  font-size: 13px;
  line-height: 1.6;
  tab-size: 2;
}

/* ─── Asset Row ─── */
.asset-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-3) 0;
}

.asset-row + .asset-row {
  border-top: 1px solid var(--border-on-white);
}

.asset-row__info {
  min-width: 0;
}

.asset-row__name {
  font-size: 13px;
  font-weight: 500;
  color: var(--black);
}

.asset-row__file {
  font-size: 12px;
  color: var(--black-faint);
  font-family: var(--font-mono);
}

/* ─── Module Item ─── */
.module-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.module-item {
  padding: var(--space-4);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--white);
}

.module-item__title {
  font-size: 15px;
  font-weight: 500;
  color: var(--black);
}

.module-item__description {
  margin-top: 2px;
  font-size: 13px;
  color: var(--black-muted);
}

/* ─── Placeholder Page ─── */
.placeholder-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: var(--space-16) var(--space-6);
  min-height: 300px;
}

.placeholder-page__icon {
  font-size: 40px;
  margin-bottom: var(--space-4);
  opacity: 0.4;
}

.placeholder-page__title {
  margin: 0;
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 500;
  color: var(--black);
}

.placeholder-page__description {
  margin: var(--space-2) 0 0;
  font-size: 14px;
  color: var(--black-muted);
  max-width: 400px;
}

.placeholder-page__badge {
  margin-top: var(--space-4);
}

/* ─── Mono ─── */
.mono {
  font-family: var(--font-mono);
  font-size: 13px;
}

/* ─── Scrollbar ─── */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--cream);
}

::-webkit-scrollbar-thumb {
  background: var(--border-strong);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--black-faint);
}

/* ─── Responsive ─── */
@media (max-width: 1024px) {
  .app-main {
    padding: var(--space-6) var(--space-5);
  }

  .hero__stats {
    gap: var(--space-10);
  }
}

@media (max-width: 960px) {
  .page-columns {
    grid-template-columns: 1fr;
  }

  .form-row {
    grid-template-columns: 1fr;
  }

  .sidebar {
    display: none;
  }

  .app-main {
    padding: var(--space-5) var(--space-4);
  }
}

@media (max-width: 640px) {
  .hero {
    min-height: 50vh;
    padding: var(--space-10) var(--space-4);
  }

  .hero__stats {
    flex-direction: column;
    gap: var(--space-6);
  }

  .stat-row {
    grid-template-columns: 1fr;
  }

  .auth-card {
    padding: var(--space-6);
  }

  .public-nav {
    padding: 0 var(--space-4);
  }

  .section {
    padding: var(--space-10) var(--space-4);
  }

  .feature-grid {
    grid-template-columns: 1fr;
  }
}
